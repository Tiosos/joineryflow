# JoineryFlow production environment — TEMPLATE.
#
# Copy to /opt/joineryflow/.env, chmod 600, and replace every __SET_ME__.
# NEVER commit the filled file; the .gitignore covers .env but not this template.
#
# This ONE file has two jobs:
#   1. `docker compose --env-file .env ...` uses it to interpolate ${...} in
#      docker-compose.prod.yml (JF_*, POSTGRES_*, MEILI_MASTER_KEY).
#   2. `env_file:` injects the same values into the containers.
# So values here are literal: do NOT use ${OTHER_VAR} references — the env_file
# parser does not interpolate them.
#
# Keep comments on their own line (scripts/check-env.sh parses KEY=VALUE lines
# and deliberately leaves '#' inside values alone, so secrets may contain it).

# --- Release / image selection (compose interpolation) ---
# Immutable release tag. Required: compose uses ${JF_VERSION:?...}, so a
# missing value fails the command instead of silently deploying :dev.
JF_VERSION=1.0.0
# Registry delivery: registry.customer.com/joineryflow
# Offline delivery : joineryflow (default), with images pre-loaded via docker load.
# Both modes use the SAME tag; CI must publish exactly this name.
JF_REGISTRY=joineryflow
# Loopback is right when the proxy runs on this host. If the proxy is on another
# machine, set this to the host's internal IP and firewall it to the proxy only.
JF_WEB_BIND=127.0.0.1
# HOST port only (the container and its healthcheck stay on 3000). Change it if
# something on the host already owns 3000, and update the proxy's upstream to
# match (deploy/proxy/nginx.conf.snippet).
JF_WEB_PORT=3000
# Absolute path used by `env_file:`. Change it if you install elsewhere.
JF_ENV_FILE=/opt/joineryflow/.env

# --- Database ---
POSTGRES_USER=jf
# Strong, unique per customer. Must match the password embedded in DATABASE_URL.
POSTGRES_PASSWORD=__SET_ME__
POSTGRES_DB=joineryflow
# Keep user/password/db in step with the three values above.
DATABASE_URL=postgresql+psycopg://jf:__SET_ME__@db:5432/joineryflow

# --- API / web ---
# Container-internal (Q1). Do not put a public URL here: the browser never
# talks to the api, and a cross-site origin would break the Lax session cookie.
# Read at runtime by the web tier (PR A, C7) — changing it needs a restart.
API_URL=http://api:8000
SESSION_COOKIE_NAME=jf_session
SESSION_SLIDING_DAYS=14
SESSION_HARD_CAP_DAYS=30
# MUST be true behind https, or session cookies travel in the clear.
COOKIE_SECURE=true
FILE_STORE_ROOT=/uploads
# Server-side runtime flag for the Procurement entry point; restart to change.
NEXT_PUBLIC_PROCUREMENT_UI_READY=1
# Surfaced by GET /version. Keep in step with JF_VERSION; check-env.sh enforces it.
APP_VERSION=1.0.0

# --- Meilisearch ---
# production mode refuses to start with a key shorter than 16 bytes.
MEILI_MASTER_KEY=__SET_ME__
MEILI_URL=http://meili:7700
# Section 3 item 5 wants this distinct from the master key. Scoped keys (7.1)
# were moved to Phase 1 by D1, so a distinct value is the current minimum.
MEILI_API_KEY=__SET_ME__
