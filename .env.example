POSTGRES_USER=jf
POSTGRES_PASSWORD=jf
POSTGRES_DB=joineryflow
DATABASE_URL=postgresql+psycopg://jf:jf@db:5432/joineryflow
API_URL=http://api:8000
# Read by both tiers — the API sets the cookie, the web reads it. Changing it
# here requires a web rebuild, since Next inlines env reads in middleware.
SESSION_COOKIE_NAME=jf_session
SESSION_SLIDING_DAYS=14
SESSION_HARD_CAP_DAYS=30
# Sets the Secure flag on the session cookie. Leave false for local http dev;
# MUST be true anywhere served over https, or the session cookie travels in
# the clear.
COOKIE_SECURE=false
FILE_STORE_ROOT=/uploads
# Shows the Procurement entry point on /tracking (sub-project #4). Off unless
# set, which is why a fresh dev setup cannot reach the Procurement Workbench
# from Tracking.
NEXT_PUBLIC_PROCUREMENT_UI_READY=1
